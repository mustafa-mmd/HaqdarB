# HaqDar AI Backend — Environment Variables

# AI APIs
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud & Vertex AI (embeddings only — index endpoint removed)
PROJECT_ID=your_gcp_project_id
LOCATION=asia-south1

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=haqdar-key.json

# Qdrant Vector Database (replaces Vertex AI Vector Search)
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=law_corpus

# Twilio (WhatsApp Bot)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SendGrid (Email Notifications)
SENDGRID_API_KEY=your_sendgrid_api_key

# Environment
ENVIRONMENT=development
DEBUG=true